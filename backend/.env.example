# 数据库连接
# 本地开发用 127.0.0.1；连远程库时改成隧道映射的地址和端口
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=swms
DB_PASSWORD=
DB_NAME=swms

# JWT 签名密钥，生成方式：
# bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_SECONDS=28800

# 初始化命令从本地环境读取密码，不设置默认密码
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# 仅 db:seed:demo 使用，须至少 8 字符
SEED_DEMO_PASSWORD=
# 集成测试仅允许名称以 swms_test_ 开头的独立库
TEST_DB_NAME=
# 重复集成测试需显式允许清理上述独立测试库的已知身份表
TEST_DB_RESET=0

# 完整虚构数据重建；留空时生成新测试密码，仅显式 --reset --database=swms 执行
DEMO_DATA_ADMIN_PASSWORD=
DEMO_DATA_PASSWORD=
# 完整数据集验收独立执行，必须为已有正式表结构的 swms_test_ 库
DEMO_TEST_DB_NAME=
DEMO_TEST_RESET=0

# 服务监听端口，默认 3000
HOST=127.0.0.1
PORT=3000

# 运行环境：development / production，默认 development
NODE_ENV=development

# 允许跨域的前端地址，多个用英文逗号分隔；默认同时允许 localhost 与 127.0.0.1
# 登录凭证走请求头，不依赖 Cookie，所以这里不需要开 credentials，也可以按需配成 *
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# 开发超级管理员（全局查看、项目维护和档案填报；生产环境忽略此项）
DEV_SUPERADMIN_USERNAME=

# 合同附件持久目录与单文件大小（默认20MB）；生产使用版本目录外的绝对路径
UPLOAD_DIR=./storage/contracts
UPLOAD_MAX_BYTES=20971520
