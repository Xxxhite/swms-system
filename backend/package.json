{
  "name": "swms-api",
  "version": "0.1.0",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check src drizzle.config.ts eslint.config.mjs tsconfig.json package.json .prettierrc.json",
    "format": "prettier --write src drizzle.config.ts eslint.config.mjs tsconfig.json package.json .prettierrc.json",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun src/db/seed.ts",
    "db:seed:demo": "bun src/db/seed.ts --demo",
    "test:integration": "bun test src/modules/identity/identity.integration.test.ts"
  },
  "dependencies": {
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/cron": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "9",
    "eslint-config-prettier": "10",
    "globals": "16",
    "prettier": "3",
    "typescript": "~5.9.3",
    "typescript-eslint": "8"
  },
  "module": "src/index.ts",
  "private": true
}
