# 初次使用 HTTP 完成站点核对，再由 Certbot 为此域名单独配置 HTTPS。
server {
    client_max_body_size 22m;
    listen 80;
    listen [::]:80;
    server_name __APP_DOMAIN__;

    root __APP_ROOT__/current/frontend/dist;
    index index.html;
    access_log /var/log/nginx/swms.access.log;
    error_log /var/log/nginx/swms.error.log;

    location /api/ {
        # 发布维护期间阻止新的业务请求；静态页面仍可访问。
        if (-f __APP_ROOT__/maintenance) { return 503; }
        # 不带尾部斜杠，保留后端需要的 /api 前缀。
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location = /health {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
    }

    # 旧版本页面仍可能请求旧的按需加载文件，保留历次带哈希的资源。
    location ^~ /assets/ {
        alias __APP_ROOT__/assets/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~ /\. { deny all; }

    # hash 路由由浏览器处理；未知服务器路径返回 404，不伪装成 HTML 接口响应。
    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-store";
    }
}
