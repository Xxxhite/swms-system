[Unit]
Description=SWMS API
After=network.target mysql.service
Requires=mysql.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__APP_ROOT__/current/backend
EnvironmentFile=__APP_ROOT__/shared/backend.env
ExecStart=__APP_ROOT__/runtime/bun/bin/bun run src/index.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
