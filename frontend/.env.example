# 接口基础路径：开发环境走 vite 代理（见 vite.config.ts），保持 /api 即可
VITE_API_BASE_URL=/api

# 是否使用本地 mock 数据：默认开启，设成 false 才连真实后端
# mock 实现在 src/mock/，登录接口 POST /auth/login、当前用户 GET /auth/profile
VITE_USE_MOCK=true

# 仅开发登录页快捷填入使用；在本地 .env.local 配置测试密码，留空则手动输入
# 管理员和其余虚构测试账号分别配置，不填写真实业务账号密码
VITE_DEV_ADMIN_PASSWORD=
VITE_DEV_DEMO_PASSWORD=
