{
  "name": "swms-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check src tests vite.config.ts eslint.config.mjs *.json",
    "format": "prettier --write src tests vite.config.ts eslint.config.mjs *.json",
    "test": "bun test ./tests",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "pinia": "^4.0.3",
    "vue": "^3.5.24",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@types/bun": "^1.4.3",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "9",
    "eslint-config-prettier": "10",
    "eslint-plugin-vue": "10",
    "globals": "16",
    "prettier": "3",
    "typescript": "~5.9.3",
    "typescript-eslint": "8",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4"
  }
}
